# このファイルを .env にコピーして使ってください。
# .env はGitへコミットしないこと(仕様書14: シークレットをソースへ直書きしない)。

# --- 基本 ---
APP_NAME=Brain Twin
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- ポート ---
# WEB_PORT: Tailscale経由で外部公開する唯一のポート(Nginxが/apiもFastAPIへ内部転送する)。
WEB_PORT=8080
# SERVER_PORT: 追加修正により、serverはデフォルトで外部ポートを公開しなくなった
# (web経由の同一オリジンプロキシのみを使う)。この値は、開発者が独自の
# docker-compose.override.yml でserverを直接デバッグ用に公開したい場合にのみ参照される。
SERVER_PORT=8000

# --- Ollama ---
# デフォルト: ホスト側に別途インストールしたOllamaを使う。
# Docker内Ollamaを使う場合は http://ollama:11434 に変更し、
# `docker compose --profile dockerized-ollama up -d` で起動すること。
OLLAMA_BASE_URL=http://host.docker.internal:11434
# 日本語性能と軽さのバランスを考慮したデフォルト。VRAM/RAMが厳しい場合は
# qwen2.5:3b-instruct、より高精度が必要なら qwen2.5:14b-instruct 等に変更可能。
OLLAMA_MODEL=qwen2.5:7b-instruct
# 埋め込み(意味検索)専用モデル。生成モデルとは意図的に分離している。
# bge-m3は日本語含む100+言語の意味検索に強く、MITライセンスで軽量(数百MB程度)。
# 代替: nomic-embed-text-v2-moe(多言語対応)、qwen3-embedding:0.6b(超軽量)
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_REQUEST_TIMEOUT_SECONDS=60
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_MAX_RETRIES=2

# --- 認証 ---
PAIRING_CODE_TTL_SECONDS=600
DEVICE_TOKEN_BYTES=32
RATE_LIMIT_PER_MINUTE=120

# --- CORS ---
# 基本は空でよい(同一オリジン運用)。PWAで問題が出た場合のみ、
# 実際にアクセスするorigin(例: https://your-pc.tailxxxx.ts.net:8080)を追加する。
ALLOWED_ORIGINS_RAW=

# --- バックアップ ---
BACKUP_RETENTION_GENERATIONS=7
BACKUP_SCHEDULE_HOUR=3

# --- ジョブワーカー ---
JOB_POLL_INTERVAL_SECONDS=2
JOB_MAX_ATTEMPTS=5
