{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brain-twin-organizer-output-v1",
  "title": "Brain Twin Organizer Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory_worthy",
    "memory_type",
    "title",
    "topics",
    "entities",
    "event_date",
    "importance",
    "confidence",
    "link_candidates"
  ],
  "properties": {
    "memory_worthy": {"type": "boolean"},
    "memory_type": {
      "type": "string",
      "enum": ["fact", "experience", "thought", "decision", "preference", "goal", "knowledge", "person", "project"]
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 48},
    "topics": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    },
    "entities": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "confidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
        }
      }
    },
    "event_date": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "date"}
      ]
    },
    "importance": {"type": "integer", "minimum": 1, "maximum": 5},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "link_candidates": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    }
  }
}
